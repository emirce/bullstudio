{
  "name": "bullstudio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=1",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "pack:check": "node scripts/verify-public-packs.mjs",
    "format": "biome format --write .",
    "check": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@bullstudio/typescript-config": "workspace:*",
    "@changesets/cli": "^2.31.0",
    "tsup": "^9.0.0",
    "turbo": "^2.11.13",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.2",
      "@types/react-dom": "19.3.0",
      "ioredis": "^5.11.1"
    }
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
