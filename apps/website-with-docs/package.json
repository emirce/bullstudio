{
  "name": "@bullstudio/website-with-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-sitemap.mjs && react-router build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "dev": "react-router dev",
    "start": "serve ./build/client --config ../../serve.json",
    "typecheck": "react-router typegen && fumadocs-mdx && tsc --noEmit",
    "lint": "biome lint .",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@posthog/react": "^1.11.3",
    "@react-router/node": "^7.18.2",
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.1",
    "fumadocs-ui": "16.19.0",
    "isbot": "^5.2.3",
    "lucide-react": "^1.72.0",
    "posthog-js": "^1.448.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react-router-devtools": "^6.2.3",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
